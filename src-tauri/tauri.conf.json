{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flowkey",
  "version": "0.1.0",
  "identifier": "com.flowkey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "FlowKey",
        "width": 780,
        "height": 510,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "shadow": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}